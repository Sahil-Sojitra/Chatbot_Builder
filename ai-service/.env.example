# Service Environment Configuration
# Allowed values: development | production | staging | testing
# In production (or any unspecified value), /demo routes are disabled and INTERNAL_API_KEY is strictly required.
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Service Authentication / Internal Communication
# Required for production; requests to /api/v1/chat/*, /api/v1/ingest/*, and /vector-store/*
# must supply this value in the X-API-Key request header.
# Must match the backend's AI_SERVICE_API_KEY or INTERNAL_API_KEY.
INTERNAL_API_KEY=your_secure_randomly_generated_internal_api_key_here

# LLM Providers (Configure as needed for BYOK / fallback generation)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=

# Embedding Provider (Voyage AI)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4
VOYAGE_BATCH_SIZE=128

# Vector Database (Pinecone Serverless)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=chatbot-builder
