NODE_ENV=development
PORT=5000
MONGODB_URI=

# Auth
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
BCRYPT_SALT_ROUNDS=12
REFRESH_TOKEN_TTL_DAYS=30

# R2 (S3-compatible) object storage — required only for the knowledge-source
# file-upload endpoint. Leave unset if you're not using that endpoint yet.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
