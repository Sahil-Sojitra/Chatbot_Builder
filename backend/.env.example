NODE_ENV=development
PORT=5000
MONGODB_URI=

# Auth
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
BCRYPT_SALT_ROUNDS=12
REFRESH_TOKEN_TTL_DAYS=30

# The frontend's origin — the only origin allowed to make credentialed
# (cookie-bearing) requests to this API. Defaults to the Next.js dev server;
# set to the real deployed frontend origin in production.
FRONTEND_ORIGIN=http://localhost:3000

# R2 (S3-compatible) object storage — required only for the knowledge-source
# file-upload endpoint. Leave unset if you're not using that endpoint yet.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional: override the S3 client endpoint, e.g. to point at a local
# MinIO server instead of Cloudflare R2. Leave unset to use the
# R2_ACCOUNT_ID-derived Cloudflare endpoint.
R2_ENDPOINT=

# Redis connection for the BullMQ knowledge-source ingestion queue — required
# only to run the ingestion worker (src/worker.ts) and to have upload/create
# requests actually enqueue a job. Leave unset for local dev without a queue;
# knowledge sources are simply left PENDING until a value is set.
REDIS_URL=
